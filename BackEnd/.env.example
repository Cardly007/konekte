# --- Database Configuration ---
# These are the default credentials used by the docker-compose.yml file.
DATABASE_URL=postgresql://konekte_user:Nap_lite@localhost:5432/konekte_db

# --- Redis Configuration ---
# These are the default credentials used by the docker-compose.yml file.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=a-secure-password-for-redis

# --- JWT Configuration ---
JWT_SECRET_KEY=a-very-secret-key-for-jwt
JWT_ALGORITHM=HS256

# --- Third-Party Services (Optional for initial startup) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY="your_private_key"

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid

SENTRY_DSN=

# --- Application Environment ---
ENVIRONMENT=development
